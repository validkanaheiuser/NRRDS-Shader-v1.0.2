{
  "name": "audio-bridge-server",
  "version": "4.0.0",
  "description": "Audio Bridge server — Node.js port",
  "main": "server.js",
  "scripts": {
    "postinstall": "pnpm -C dashboard install",
    "build:web": "pnpm -C dashboard run build",
    "start": "pnpm -C dashboard run build && node --experimental-sqlite server.js",
    "server": "node --experimental-sqlite server.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.9.0",
    "opusscript": "^0.1.1"
  }
}
